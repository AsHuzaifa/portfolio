---
import { projects } from '../data/site';
import { buildFluidBackground } from '../utils/fluidArt';
import { getBaseUrl } from '../utils/basePath';

const base = getBaseUrl();
---

<section id="builds" class="px-8 md:px-20 lg:px-32 pt-24 pb-28">
  <div class="max-w-[1200px] mx-auto">

    <!-- Section entry: thin rule + label -->
    <div class="mb-16 md:mb-20">
      <hr class="border-t border-muted/20" />
      <div class="flex justify-between items-baseline mt-4">
        <p class="projects-label text-muted text-xs tracking-[0.2em] uppercase">Builds</p>
        <span class="text-muted/25 text-xs tracking-[0.2em] font-body">02</span>
      </div>
    </div>

    <!-- Project tiles - fluid art background per project, glass panel holds title + tagline -->
    <div class="projects-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {projects.map((project, i) => (
        <a
          href={`${base}projects/${project.slug}/`}
          class="project-tile group relative block aspect-[8/5] rounded-2xl overflow-hidden
                 transition-transform duration-500 hover:scale-[1.02]"
        >
          <!-- Slightly oversized + softly blurred gradient blobs, with a mild rotation
               so the swirl isn't perfectly axis-aligned - reads as marbled fluid art -->
          <div
            class={`absolute -inset-[6%] blur-2xl transition-transform duration-700 group-hover:scale-110
                    ${i % 2 === 0 ? 'rotate-3' : '-rotate-2'}`}
            style={{
              backgroundImage: buildFluidBackground(project.fluid, i),
              backgroundColor: project.fluid[project.fluid.length - 1],
            }}
          />

          <!-- Glass panel - title + tagline -->
          <div class="absolute inset-x-5 bottom-5 md:inset-x-6 md:bottom-6
                      bg-white/12 backdrop-blur-lg border border-white/25 rounded-xl px-5 py-4">
            <p class="font-display font-light text-white text-lg md:text-xl tracking-[-0.01em] mb-1.5">
              {project.name}
            </p>
            <p class="text-white/80 text-[0.78rem] leading-relaxed font-body font-light">
              {project.tagline}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
