---
import { certificates } from '../data/site';
import { getBaseUrl } from '../utils/basePath';

const base = getBaseUrl();
---

<section id="certificates" class="px-8 md:px-20 lg:px-32 pt-24 pb-28">
  <div class="max-w-[1200px] mx-auto">

    <!-- Section entry: thin rule + label -->
    <div class="mb-16 md:mb-20">
      <hr class="border-t border-muted/20" />
      <div class="flex justify-between items-baseline mt-4">
        <p class="certificates-label text-muted text-xs tracking-[0.2em] uppercase">Certificates</p>
        <span class="text-muted/25 text-xs tracking-[0.2em] font-body">04</span>
      </div>
    </div>

    <!-- Certificate cards -->
    <div class="certificates-grid grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {certificates.map((cert) => (
        <div class="certificate-card bg-surface/30 border border-muted/25 px-7 py-8 lg:px-9 lg:py-10
                    hover:shadow-[0_0_28px_rgba(42,74,62,0.09)] transition-shadow duration-500">

          <!-- Brand logo + date -->
          <div class="flex items-center justify-between mb-6">
            <img src={`${base}${cert.logo.src.slice(1)}`} alt={cert.logo.alt} class="h-10 w-24 object-contain object-left" />
            <span class="text-muted/40 text-[0.68rem] font-body">{cert.date}</span>
          </div>

          <!-- Name -->
          <p class="font-display font-light text-text text-lg md:text-xl tracking-[-0.01em] mb-5">
            {cert.name}
          </p>

          <!-- Highlights -->
          <ul class="space-y-2.5 mb-7">
            {cert.highlights.map((point) => (
              <li class="text-muted/70 text-[0.85rem] leading-[1.65] font-body font-light pl-4 relative
                         before:content-['—'] before:absolute before:left-0 before:text-muted/30">
                {point}
              </li>
            ))}
          </ul>

          <!-- View certificate -->
          <a
            href={`${base}${cert.pdf.slice(1)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-baseline gap-2 text-[0.68rem] tracking-[0.15em] uppercase
                   text-muted/50 hover:text-accent-alt transition-colors duration-300"
          >
            View Certificate
            <span class="text-muted/25 group-hover:text-accent-alt/50 transition-colors duration-300">↗</span>
          </a>

        </div>
      ))}
    </div>

  </div>
</section>
