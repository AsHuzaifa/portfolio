---
// Resume link styled as a flat, front-facing envelope: deep green with a
// thin cream botanical line-art motif (original artwork inspired by a
// reference mockup, not copied from it) and a small "resume" label at the
// bottom-right corner. Wrapped in a LiquidMetalFrame for an animated chrome
// border (WebGL shader) - a decorative trial the user may drop if they don't
// like it, kept as a separate wrapper for exactly that reason.
import LiquidMetalFrame from './LiquidMetalFrame.tsx';

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<LiquidMetalFrame client:load borderRadius={8} borderWidth={2} className="block w-full max-w-[460px] aspect-[2/1]">
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Open resume (opens in a new tab)"
  class="group relative block w-full h-full
         transition-transform duration-300 ease-out
         hover:-translate-y-1"
>
  <svg viewBox="0 0 480 240" class="w-full h-full drop-shadow-[0_10px_24px_rgba(0,0,0,0.18)]">
    <rect x="1" y="1" width="478" height="238" rx="6" fill="#1B2E24" />

    <!-- Flap fold seam -->
    <polygon points="0,0 480,0 240,108" fill="none" stroke="#F5F0E8" stroke-opacity="0.22" stroke-width="1.5" />
    <!-- Side fold seams -->
    <line x1="0" y1="238" x2="240" y2="108" stroke="#F5F0E8" stroke-opacity="0.16" stroke-width="1.2" />
    <line x1="480" y1="238" x2="240" y2="108" stroke="#F5F0E8" stroke-opacity="0.16" stroke-width="1.2" />

    <!-- Botanical line art: two six-petal blossoms plus a couple of stems -->
    <g stroke="#F5F0E8" fill="none" stroke-width="1.1">
      <g stroke-opacity="0.4" transform="translate(110,168)">
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(0)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(60)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(120)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(180)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(240)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(300)" />
        <circle r="4" stroke-opacity="0.5" />
      </g>
      <g stroke-opacity="0.3" transform="translate(178,196) scale(0.62)">
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(20)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(80)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(140)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(200)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(260)" />
        <path d="M 0,0 C -13,-9 -14,-38 0,-50 C 14,-38 13,-9 0,0 Z" transform="rotate(320)" />
        <circle r="4" stroke-opacity="0.4" />
      </g>
      <path d="M 55,215 C 78,192 96,182 110,168" stroke-opacity="0.25" />
      <path d="M 150,150 C 165,158 172,172 178,188" stroke-opacity="0.22" />
    </g>
  </svg>

  <span class="absolute bottom-[9%] right-[6%] text-[0.62rem] tracking-[0.3em] uppercase text-bg/60 font-body">
    resume
  </span>
</a>
</LiquidMetalFrame>
