---
// Resume link styled as a flat envelope: cream base (matching the reference
// photo's paper tone) with its lotus-and-leaves photo cropped to a 2:1 band
// along the right edge, and a small "resume" label at the bottom-left corner.
import { getBaseUrl } from '../utils/basePath';

interface Props {
  href: string;
}

const { href } = Astro.props;
const base = getBaseUrl();
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Open resume (opens in a new tab)"
  class="group relative block w-full max-w-[460px] aspect-[2/1]
         overflow-hidden rounded-[6px] bg-[#fff9da]
         drop-shadow-[0_10px_24px_rgba(0,0,0,0.18)]
         transition-transform duration-300 ease-out
         hover:-translate-y-1"
>
  <img
    src={`${base}assets/resume-envelope-lotus.jpg`}
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
  />

  <span
    class="absolute bottom-[9%] left-[6%] text-[0.62rem] tracking-[0.3em] uppercase font-body text-[#96b893]"
  >
    resume
  </span>
</a>
