---
import { getBaseUrl } from '../utils/basePath';

interface Props {
  videos: { src: string; poster: string; caption: string }[];
}

const { videos } = Astro.props;
const base = getBaseUrl();
---

<!-- Demo clips are portrait phone footage, so they sit side by side rather than full-width -->
<div class="mb-14">
  <p class="text-muted/50 text-[0.65rem] tracking-[0.2em] uppercase font-body mb-6">In action</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-xl mx-auto">
    {videos.map((video) => (
      <figure>
        <div class="rounded-2xl overflow-hidden border border-accent-alt/25
                    shadow-[0_0_28px_rgba(42,74,62,0.16)] bg-text">
          <video
            src={`${base}${video.src.replace(/^\//, '')}`}
            poster={`${base}${video.poster.replace(/^\//, '')}`}
            class="w-full block aspect-[5/9] object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={video.caption}
          ></video>
        </div>
        <figcaption class="text-muted/60 text-[0.75rem] font-body font-light mt-3 text-center">
          {video.caption}
        </figcaption>
      </figure>
    ))}
  </div>
</div>
